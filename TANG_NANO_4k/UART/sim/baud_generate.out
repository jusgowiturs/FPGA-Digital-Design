#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e10c413bec0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e10c413c050 .scope module, "testbench" "testbench" 3 3;
 .timescale -9 -12;
P_0x5e10c4125d10 .param/l "BAUD_RATE" 1 3 9, +C4<00000000000000011100001000000000>;
P_0x5e10c4125d50 .param/l "CLK_FREQ" 1 3 8, +C4<00000001100110111111110011000000>;
v0x5e10c4154850_0 .net "baud_tick", 0 0, v0x5e10c4129b90_0;  1 drivers
v0x5e10c4154920_0 .var "clk", 0 0;
v0x5e10c41549f0_0 .var "rst_n", 0 0;
E_0x5e10c4101070 .event posedge, v0x5e10c4154560_0;
S_0x5e10c4100490 .scope module, "dut" "baud_gen" 3 14, 4 15 0, S_0x5e10c413c050;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 1 "baud_tick";
P_0x5e10c4100670 .param/l "BAUD_DIV" 1 4 25, +C4<00000000000000000000000011101010>;
P_0x5e10c41006b0 .param/l "BAUD_RATE" 0 4 17, +C4<00000000000000011100001000000000>;
P_0x5e10c41006f0 .param/l "CLK_FREQ" 0 4 16, +C4<00000001100110111111110011000000>;
v0x5e10c4129b90_0 .var "baud_tick", 0 0;
v0x5e10c4154560_0 .net "clk", 0 0, v0x5e10c4154920_0;  1 drivers
v0x5e10c4154620_0 .var "counter", 7 0;
v0x5e10c4154710_0 .net "rst_n", 0 0, v0x5e10c41549f0_0;  1 drivers
E_0x5e10c4100c70/0 .event negedge, v0x5e10c4154710_0;
E_0x5e10c4100c70/1 .event posedge, v0x5e10c4154560_0;
E_0x5e10c4100c70 .event/or E_0x5e10c4100c70/0, E_0x5e10c4100c70/1;
    .scope S_0x5e10c4100490;
T_0 ;
    %wait E_0x5e10c4100c70;
    %load/vec4 v0x5e10c4154710_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5e10c4154620_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x5e10c4129b90_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5e10c4154620_0;
    %pad/u 32;
    %cmpi/e 233, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5e10c4154620_0, 0;
    %load/vec4 v0x5e10c4129b90_0;
    %inv;
    %assign/vec4 v0x5e10c4129b90_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x5e10c4154620_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x5e10c4154620_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5e10c413c050;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e10c4154920_0, 0, 1;
T_1.0 ;
    %delay 18520, 0;
    %load/vec4 v0x5e10c4154920_0;
    %inv;
    %store/vec4 v0x5e10c4154920_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x5e10c413c050;
T_2 ;
    %vpi_call/w 3 28 "$dumpfile", "sim/baud_generate.vcd" {0 0 0};
    %vpi_call/w 3 29 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e10c413c050 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e10c41549f0_0, 0, 1;
    %delay 5000, 0;
    %load/vec4 v0x5e10c4154850_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_2.0, 4;
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 38 "$error", "FAIL: baud_tick should be LOW during reset." {0 0 0};
T_2.1 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e10c41549f0_0, 0, 1;
    %pushi/vec4 233, 0, 32;
T_2.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.3, 5;
    %jmp/1 T_2.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x5e10c4101070;
    %jmp T_2.2;
T_2.3 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %load/vec4 v0x5e10c4154850_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_2.4, 4;
    %jmp T_2.5;
T_2.4 ;
    %vpi_call/w 3 54 "$fatal", 32'sb00000000000000000000000000000001, "FAIL: baud_tick toggled too early." {0 0 0};
T_2.5 ;
    %wait E_0x5e10c4101070;
    %delay 1000, 0;
    %load/vec4 v0x5e10c4154850_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_2.6, 4;
    %jmp T_2.7;
T_2.6 ;
    %vpi_call/w 3 62 "$fatal", 32'sb00000000000000000000000000000001, "FAIL: baud_tick did not toggle after 234 clocks." {0 0 0};
T_2.7 ;
    %vpi_call/w 3 64 "$display", "--------------------------------" {0 0 0};
    %vpi_call/w 3 65 "$display", "PASS : Baud Generator Verified" {0 0 0};
    %vpi_call/w 3 66 "$display", "--------------------------------" {0 0 0};
    %delay 500000, 0;
    %vpi_call/w 3 69 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "sim/baud_generate_tb.sv";
