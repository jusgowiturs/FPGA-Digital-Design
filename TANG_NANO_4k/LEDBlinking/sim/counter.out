E_0x58d789090d60/0 .event negedge, v0x58d7890de650_0;
E_0x58d789090d60/1 .event posedge, v0x58d7890de590_0;
E_0x58d789090d60 .event/or E_0x58d789090d60/0, E_0x58d789090d60/1;
    .scope S_0x58d789090490;
T_0 ;
    %wait E_0x58d789090d60;
    %load/vec4 v0x58d7890de650_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x58d7890906c0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x58d7890de4f0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x58d7890906c0_0;
    %cmpi/e 999998, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x58d7890906c0_0, 0;
    %load/vec4 v0x58d7890de4f0_0;
    %inv;
    %assign/vec4 v0x58d7890de4f0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x58d7890906c0_0;
    %addi 1, 0, 32;
    %assign/vec4 v0x58d7890906c0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x58d7890cbc70;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x58d7890de880_0;
    %inv;
    %store/vec4 v0x58d7890de880_0, 0, 1;
