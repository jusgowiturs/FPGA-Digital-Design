v0x57cf8d070630_0 .var "ledreg", 0 0;
v0x57cf8d0706d0_0 .net "sys_clk", 0 0, v0x57cf8d0709c0_0;  1 drivers
v0x57cf8d070790_0 .net "sys_rst_n", 0 0, v0x57cf8d070a90_0;  1 drivers
E_0x57cf8d05b770/0 .event negedge, v0x57cf8d070790_0;
E_0x57cf8d05b770/1 .event posedge, v0x57cf8d0706d0_0;
E_0x57cf8d05b770 .event/or E_0x57cf8d05b770/0, E_0x57cf8d05b770/1;
    .scope S_0x57cf8d022490;
T_0 ;
    %wait E_0x57cf8d05b770;
    %load/vec4 v0x57cf8d070790_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x57cf8d0226e0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x57cf8d070630_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x57cf8d0226e0_0;
    %pad/u 32;
    %cmpi/e 4294967294, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x57cf8d0226e0_0, 0;
    %load/vec4 v0x57cf8d070630_0;
    %inv;
    %assign/vec4 v0x57cf8d070630_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x57cf8d0226e0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x57cf8d0226e0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x57cf8d05daf0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57cf8d0709c0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x57cf8d0709c0_0;
    %inv;
    %store/vec4 v0x57cf8d0709c0_0, 0, 1;
    %jmp T_1.0;
