T_2 ;
    %vpi_call/w 3 26 "$dumpfile", "sim/counter.vcd" {0 0 0};
    %vpi_call/w 3 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57cf8d05daf0 {0 0 0};
