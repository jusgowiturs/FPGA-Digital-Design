n5 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black"];
n6 [ shape=octagon, label="sys_clk", color="black", fontcolor="black"];
c9 [ shape=record, label="{{<p7> I}|led_OBUF_O\nOBUF|{<p8> O}}",  ];
c11 [ shape=record, label="{{}|ledreg_GND_G\nGND|{<p10> G}}",  ];
c12 [ shape=record, label="{{<p7> I}|sys_clk_IBUF_I\nIBUF|{<p8> O}}",  ];
