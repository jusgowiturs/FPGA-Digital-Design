c12:p8:e -> n2:w [color="black", fontcolor="black", label=""];
c13:p8:e -> n3:w [color="black", fontcolor="black", label=""];
c9:p8:e -> n4:w [color="black", fontcolor="black", label=""];
n5:e -> c13:p7:w [color="black", fontcolor="black", label=""];
n6:e -> c12:p7:w [color="black", fontcolor="black", label=""];
